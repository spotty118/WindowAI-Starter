{
  "manifest_version": 3,
  "name": "ChatHub Interceptor",
  "version": "0.1.0",
  "description": "Intercepts network and DOM events on app.chathub.gg for logging and debugging.",
  "permissions": ["storage", "scripting", "activeTab", "cookies"],
  "host_permissions": ["https://app.chathub.gg/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatHub Interceptor"
  },
  "content_scripts": [
    {
      "matches": ["https://app.chathub.gg/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://app.chathub.gg/*"]
    }
  ]
}
